# Deployment-Konfiguration für docker-compose.deploy.yml
# Diese Datei nach .env.deploy kopieren und die Werte anpassen.

# DockerHub-Benutzername (z. B. jfuerlinger)
DOCKERHUB_USERNAME=

# Image-Tag (z. B. latest, 1.2.3, 1.2, sha-abc1234)
IMAGE_TAG=latest

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=sublydb

# Exponierte Ports (optional, Standard: 8080 / 4173)
BACKEND_PORT=8080
FRONTEND_PORT=4173

# Backend-URL für das Frontend-Nginx-Proxying (ohne /api-Suffix)
FRONTEND_BACKEND_URL=http://backend:8080
