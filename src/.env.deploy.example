# Deployment-Konfiguration für docker-compose.deploy.yml
# Diese Datei nach .env.deploy kopieren und die Werte anpassen.

# DockerHub-Benutzername (z. B. jfuerlinger)
DOCKERHUB_USERNAME=

# Image-Tag (z. B. latest, v1.2.3, sha-abc1234)
IMAGE_TAG=latest

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMe!
POSTGRES_DB=sublydb

# Exponierte Ports (optional, Standard: 8080 / 4173)
BACKEND_PORT=8080
FRONTEND_PORT=4173
